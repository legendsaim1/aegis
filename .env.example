# === Base URLs ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# === Primary Gemini Keys (Vision/OCR) ===
# Each from a SEPARATE Google Cloud project for independent quotas
# Supports up to 20 keys dynamically: GEMINI_API_KEY_1 through GEMINI_API_KEY_20
# Fill only the keys you own; leave unused entries blank.
GEMINI_API_KEY_1=your_first_gemini_key
GEMINI_API_KEY_2=your_second_gemini_key
GEMINI_API_KEY_3=your_third_gemini_key
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# === Groq Keys (Text: grading, rubrics, copy detection, analytics) ===
# Each from a SEPARATE Groq account at https://console.groq.com
# Supports up to 40 keys dynamically: GROQ_API_KEY_1 through GROQ_API_KEY_40
# Fill only the keys you own; leave unused entries blank.
GROQ_API_KEY_1=your_first_groq_key
GROQ_API_KEY_2=your_second_groq_key
GROQ_API_KEY_3=your_third_groq_key
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# === Backup Gemini Keys (Failover for ALL tasks) ===
# Each from a SECOND Google Cloud project per member
# Supports up to 20 keys dynamically: GEMINI_BACKUP_KEY_1 through GEMINI_BACKUP_KEY_20
# Fill only the keys you own; leave unused entries blank.
GEMINI_BACKUP_KEY_1=your_first_backup_gemini_key
GEMINI_BACKUP_KEY_2=your_second_backup_gemini_key
GEMINI_BACKUP_KEY_3=your_third_backup_gemini_key
GEMINI_BACKUP_KEY_4=
GEMINI_BACKUP_KEY_5=
GEMINI_BACKUP_KEY_6=
